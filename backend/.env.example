# === Base de datos ===
# Conexión asíncrona (usada por la app FastAPI con asyncpg)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/solar_db

# Conexión síncrona (usada solo por Alembic para migraciones con psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/solar_db

# === Aplicación ===
PROJECT_NAME=Solar API
DEBUG=true

# === CORS (orígenes separados por coma) ===
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
